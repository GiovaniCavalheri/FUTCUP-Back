generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  playerId  Int    @id @default(autoincrement())
  namePlayer String @db.VarChar(100)
  imgPlayer String?
  position  String @db.VarChar(50)
  numberTshirt Int
  teamId    Int
  team      Team   @relation(fields: [teamId], references: [teamId])
}

model Team {
  teamId    Int    @id @default(autoincrement())
  nameTeam  String @db.VarChar(100)
  imgShield String?

  players   Player[]
}

model News {
  newsId  Int @id @default(autoincrement())
  title String @db.VarChar(100)
  description String @db.VarChar(250)
  imgNews String? 
  date DateTime
}